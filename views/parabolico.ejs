<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Simulador Física</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .parabolico-layout {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 24px;
            height: calc(100vh - 140px);
        }

        .parabolico-card {
            display: flex;
            flex-direction: column;
            gap: 16px;
            overflow-y: auto;
        }

        .parabolico-simulation-view {
            position: relative;
            background: #020617;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            height: 100%;
            width: 100%;
            display: flex;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .btn-split-parabolico {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid var(--accent-parabolico);
            color: var(--accent-parabolico);
        }

        .btn-split-parabolico:hover {
            background: rgba(244, 63, 94, 0.25);
        }

        .auto-split-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(0, 0, 0, 0.2);
            padding: 8px 12px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 0.82rem;
            color: var(--text-muted);
            user-select: none;
        }

        .checkbox-container input[type="checkbox"] {
            accent-color: var(--accent-parabolico);
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

        .interval-wrapper {
            display: none;
            align-items: center;
            gap: 6px;
        }

        .interval-wrapper.active {
            display: flex;
        }

        .select-preset {
            font-family: var(--font-main);
            font-size: 0.85rem;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 12px;
            border-radius: var(--radius-md);
            width: 100%;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
        }

        .select-preset:focus {
            border-color: var(--accent-parabolico);
        }

        .select-preset option {
            background-color: var(--bg-card);
            color: var(--text-main);
        }

        /* Overlay de Conteo Regresivo */
        .countdown-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(2, 6, 23, 0.4);
            backdrop-filter: blur(2px);
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            z-index: 10;
            pointer-events: none;
        }

        .countdown-overlay.active {
            display: flex;
        }

        .countdown-number {
            font-family: var(--font-mono);
            font-size: 6rem;
            font-weight: 700;
            color: var(--accent-parabolico);
            text-shadow: 0 0 30px var(--accent-parabolico);
            animation: popIn 0.5s ease-out;
        }

        .countdown-text {
            font-size: 1.1rem;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 8px;
        }

        @keyframes popIn {
            0% { transform: scale(0.4); opacity: 0; }
            50% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body>

    <!-- Menú Lateral Reutilizable -->
    <%- include('partials/sidebar') %>

    <!-- Área de Contenido Principal -->
    <main style="height: 100vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="section-header" style="margin-bottom: 16px;">
            <div>
                <h1 class="section-title">Movimiento Parabólico</h1>
                <p class="section-subtitle">Lanzamiento de proyectil bidimensional bajo la gravedad.</p>
            </div>
            <span class="section-badge" id="para-g-badge" style="color: var(--accent-parabolico); border-color: var(--accent-parabolico);">g = 9.81 m/s²</span>
        </div>

        <div class="parabolico-layout">
            <div class="card parabolico-card">
                <h2 class="card-title">Parámetros de Lanzamiento</h2>

                <!-- Altura Inicial h0 -->
                <div class="input-group">
                    <label for="para-h0">Altura Inicial del Cañón (h₀)</label>
                    <div class="input-control">
                        <input type="range" id="para-h0" min="0" max="200" step="1" value="0">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="para-h0-num" min="0" max="200" value="0">
                            <span class="unit-label">m</span>
                        </div>
                    </div>
                </div>

                <!-- Velocidad Inicial v0 -->
                <div class="input-group">
                    <label for="para-v0">Velocidad Inicial (v₀)</label>
                    <div class="input-control">
                        <input type="range" id="para-v0" min="5" max="150" step="1" value="45">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="para-v0-num" min="5" max="150" value="45">
                            <span class="unit-label">m/s</span>
                        </div>
                    </div>
                </div>

                <!-- Ángulo de Lanzamiento theta -->
                <div class="input-group">
                    <label for="para-angle">Ángulo de Lanzamiento (θ)</label>
                    <div class="input-control">
                        <input type="range" id="para-angle" min="0" max="85" step="1" value="45">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="para-angle-num" min="0" max="85" value="45">
                            <span class="unit-label">°</span>
                        </div>
                    </div>
                </div>

                <!-- Gravedad -->
                <div class="input-group">
                    <label for="para-g">Gravedad (g)</label>
                    <div class="input-control">
                        <input type="range" id="para-g" min="0.5" max="300" step="0.1" value="9.8">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="para-g-num" min="0.5" max="300" step="0.1" value="9.8">
                            <span class="unit-label">m/s²</span>
                        </div>
                    </div>
                </div>

                <!-- Selector de Presets Planetarios -->
                <div class="input-group">
                    <label for="para-gravity-preset">Preset de Gravedad Planetaria / Estelar</label>
                    <select id="para-gravity-preset" class="select-preset" onchange="applyParaGravityPreset()">
                        <option value="" disabled selected>-- Seleccionar cuerpo celeste --</option>
                        <optgroup label="Estrellas y Planetas">
                            <option value="274">Sol (274 m/s²)</option>
                            <option value="3.7">Mercurio (3.7 m/s²)</option>
                            <option value="8.87">Venus (8.87 m/s²)</option>
                            <option value="9.81">Tierra (9.81 m/s²)</option>
                            <option value="3.71">Marte (3.71 m/s²)</option>
                            <option value="24.79">Júpiter (24.79 m/s²)</option>
                            <option value="10.44">Saturno (10.44 m/s²)</option>
                            <option value="8.69">Urano (8.69 m/s²)</option>
                            <option value="11.15">Neptuno (11.15 m/s²)</option>
                            <option value="0.62">Plutón (0.62 m/s²)</option>
                        </optgroup>
                        <optgroup label="Satélites Naturales">
                            <option value="1.62">Luna (Tierra) (1.62 m/s²)</option>
                            <option value="1.796">Ío (Júpiter) (1.80 m/s²)</option>
                            <option value="1.315">Europa (Júpiter) (1.32 m/s²)</option>
                            <option value="1.428">Ganímedes (Júpiter) (1.43 m/s²)</option>
                            <option value="1.235">Calisto (Júpiter) (1.24 m/s²)</option>
                        </optgroup>
                    </select>
                </div>

                <!-- Opción Parciales Automáticos -->
                <div class="auto-split-box">
                    <label class="checkbox-container">
                        <input type="checkbox" id="para-auto-split" onchange="toggleParaAutoSplitUI()">
                        <span>Parciales Automáticos</span>
                    </label>

                    <div class="interval-wrapper" id="para-interval-wrapper">
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Cada:</span>
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="para-split-interval" min="0.1" max="60" step="0.5" value="1" style="width: 65px;">
                            <span class="unit-label">s</span>
                        </div>
                    </div>
                </div>

                <div class="metrics-panel">
                    <div>
                        <div class="metric-title">Tiempo (t)</div>
                        <div class="metric-value" id="para-time-disp">0.00 s</div>
                    </div>
                    <div>
                        <div class="metric-title">Alcance (x)</div>
                        <div class="metric-value" id="para-x-disp">0.0 m</div>
                    </div>
                    <div>
                        <div class="metric-title">Altura (y)</div>
                        <div class="metric-value" id="para-y-disp">0.0 m</div>
                    </div>
                    <div>
                        <div class="metric-title">Estado</div>
                        <div class="metric-value" id="para-status-disp" style="font-size: 0.85rem; color: var(--accent-parabolico);">Listo</div>
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn-action" id="btn-para-start" style="background: var(--accent-parabolico); color: #fff;" onclick="toggleParabolico()">Disparar</button>
                    <button class="btn-action btn-split-parabolico" onclick="takeParaSplit()">Parcial</button>
                    <button class="btn-action btn-secondary" onclick="resetParabolico()">Reiniciar</button>
                </div>

                <!-- Tabla de Registro de Parciales -->
                <div class="splits-card">
                    <div class="splits-title">Tiempos Parciales</div>
                    <table class="splits-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Total (t / x / y)</th>
                                <th>Relativo (Δt / Δx / Δy)</th>
                            </tr>
                        </thead>
                        <tbody id="para-splits-body">
                            <tr>
                                <td colspan="3" style="color: var(--text-muted); text-align: center; padding: 10px 0;">Sin parciales</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="parabolico-simulation-view" id="para-container">
                <canvas id="canvas-parabolico"></canvas>
            </div>
        </div>
    </main>

    <script>
        function applyParaGravityPreset() {
            const select = document.getElementById('para-gravity-preset');
            const gVal = parseFloat(select.value);

            if (!isNaN(gVal)) {
                const slider = document.getElementById('para-g');
                const numInput = document.getElementById('para-g-num');

                slider.value = gVal;
                numInput.value = gVal;

                document.getElementById('para-g-badge').textContent = `g = ${gVal} m/s²`;

                if (!paraIsRunning && typeof drawParabolicoScene === 'function') {
                    drawParabolicoScene();
                }
            }
        }

        function toggleParaAutoSplitUI() {
            const isChecked = document.getElementById('para-auto-split').checked;
            const wrapper = document.getElementById('para-interval-wrapper');
            if (isChecked) {
                wrapper.classList.add('active');
            } else {
                wrapper.classList.remove('active');
            }
        }

        // Sincronización bidireccional entre Sliders e Inputs Numéricos
        document.querySelectorAll('input[type="range"]').forEach(slider => {
            const numInput = document.getElementById(`${slider.id}-num`);
            
            if (numInput) {
                slider.addEventListener('input', (e) => {
                    numInput.value = e.target.value;
                    triggerParaInputEvent(slider.id);
                });

                numInput.addEventListener('input', (e) => {
                    let val = parseFloat(e.target.value);
                    const min = parseFloat(slider.min);
                    const max = parseFloat(slider.max);

                    if (isNaN(val)) return;

                    if (val < min) val = min;
                    if (val > max) val = max;

                    slider.value = val;
                    triggerParaInputEvent(slider.id);
                });
            }
        });

        function triggerParaInputEvent(id) {
            if (id === 'para-g' || id === 'para-g-num') {
                const gVal = document.getElementById('para-g').value;
                document.getElementById('para-g-badge').textContent = `g = ${gVal} m/s²`;
            }

            if (!paraIsRunning && typeof drawParabolicoScene === 'function') {
                drawParabolicoScene();
            }
        }

        // -------------------------------------------------------------
        // SIMULADOR MOVIMIENTO PARABÓLICO (CON REGLAS Y ESCALAS VISIBLES)
        // -------------------------------------------------------------
        let canvasPara, ctxPara;
        let paraAnimationId = null;
        let paraIsRunning = false;
        let isCountingDown = false;
        let paraTime = 0;
        let paraX = 0;
        let paraY = 0;
        let lastTimestamp = 0;

        let dynamicScalePixelPerMeter = 4;

        let paraSplits = [];
        let paraLastSplitTime = 0;
        let paraLastSplitX = 0;
        let paraLastSplitY = 0;
        let paraNextAutoSplitTime = 0;

        function initParabolico() {
            canvasPara = document.getElementById('canvas-parabolico');
            const container = document.getElementById('para-container');
            
            if (!canvasPara || !container) return;

            canvasPara.width = container.clientWidth;
            canvasPara.height = container.clientHeight;

            ctxPara = canvasPara.getContext('2d');
            drawParabolicoScene();
        }

        function calculateMaxDimensions() {
            const h0 = parseFloat(document.getElementById('para-h0').value) || 0;
            const v0 = parseFloat(document.getElementById('para-v0').value) || 45;
            const angleVal = document.getElementById('para-angle').value;
            const angleDeg = angleVal !== "" ? parseFloat(angleVal) : 45;
            const g = parseFloat(document.getElementById('para-g').value) || 9.81;

            const angleRad = (angleDeg * Math.PI) / 180;
            const v0x = v0 * Math.cos(angleRad);
            const v0y = v0 * Math.sin(angleRad);

            const disc = Math.pow(v0y, 2) + (2 * g * h0);
            const tFlight = (v0y + Math.sqrt(Math.max(0, disc))) / g;

            const maxX = Math.max(v0x * tFlight, 5);

            let maxY = h0;
            if (v0y > 0) {
                maxY = h0 + (Math.pow(v0y, 2) / (2 * g));
            }

            return { maxX, maxY, h0 };
        }

        function drawParabolicoScene() {
            const width = canvasPara.width;
            const height = canvasPara.height;

            ctxPara.clearRect(0, 0, width, height);

            const cannonX = 60;
            const groundY = height - 40;

            const { maxX, maxY, h0 } = calculateMaxDimensions();

            // 1. Escala X (Alcance horizontal al 95%)
            const availableWidthPixel = (width * 0.95) - cannonX;
            const scaleX = availableWidthPixel / maxX;

            // 2. Escala Y (Apogeo máximo no sobrepasa el borde superior de 40px)
            const availableHeightPixel = groundY - 40;
            const scaleY = availableHeightPixel / (maxY + 2);

            dynamicScalePixelPerMeter = Math.min(scaleX, scaleY);

            const cannonY = groundY - (h0 * dynamicScalePixelPerMeter);

            // -------------------------------------------------------------
            // DIBUJAR REGLAS Y MARCAS DE ESCALA (HORIZONTAL X Y VERTICAL Y)
            // -------------------------------------------------------------

            // Regla Horizontal (X) en el Suelo
            ctxPara.fillStyle = '#1e293b';
            ctxPara.fillRect(0, groundY, width, height - groundY);

            ctxPara.strokeStyle = '#f43f5e';
            ctxPara.lineWidth = 3;
            ctxPara.beginPath();
            ctxPara.moveTo(0, groundY);
            ctxPara.lineTo(width, groundY);
            ctxPara.stroke();

            ctxPara.fillStyle = '#64748b';
            ctxPara.font = '10px "JetBrains Mono"';
            ctxPara.textAlign = 'center';

            let stepX = 10;
            if (maxX > 50) stepX = 20;
            if (maxX > 150) stepX = 50;
            if (maxX > 400) stepX = 100;

            for (let mX = 0; mX <= maxX; mX += stepX) {
                const tickX = cannonX + (mX * dynamicScalePixelPerMeter);
                if (tickX <= width - 10) {
                    ctxPara.beginPath();
                    ctxPara.moveTo(tickX, groundY);
                    ctxPara.lineTo(tickX, groundY + 6);
                    ctxPara.strokeStyle = '#64748b';
                    ctxPara.lineWidth = 1;
                    ctxPara.stroke();
                    ctxPara.fillText(`${mX}m`, tickX, groundY + 20);
                }
            }

            // Regla Vertical (Y) en la Orilla Izquierda
            const rulerY_X = 30;
            ctxPara.strokeStyle = '#334155';
            ctxPara.lineWidth = 2;
            ctxPara.beginPath();
            ctxPara.moveTo(rulerY_X, 20);
            ctxPara.lineTo(rulerY_X, groundY);
            ctxPara.stroke();

            ctxPara.textAlign = 'right';
            let stepY = 5;
            if (maxY > 30) stepY = 10;
            if (maxY > 100) stepY = 25;
            if (maxY > 300) stepY = 50;

            for (let mY = 0; mY <= maxY; mY += stepY) {
                const tickY = groundY - (mY * dynamicScalePixelPerMeter);
                if (tickY >= 20) {
                    ctxPara.beginPath();
                    ctxPara.moveTo(rulerY_X - 5, tickY);
                    ctxPara.lineTo(rulerY_X, tickY);
                    ctxPara.strokeStyle = '#64748b';
                    ctxPara.lineWidth = 1;
                    ctxPara.stroke();
                    ctxPara.fillText(`${mY}m`, rulerY_X - 8, tickY + 3);
                }
            }

            // Indicador del Punto de Impacto Estimado en X
            const impactX = cannonX + (maxX * dynamicScalePixelPerMeter);
            ctxPara.strokeStyle = '#f43f5e';
            ctxPara.lineWidth = 2;
            ctxPara.setLineDash([4, 4]);
            ctxPara.beginPath();
            ctxPara.moveTo(impactX, groundY - 30);
            ctxPara.lineTo(impactX, groundY);
            ctxPara.stroke();
            ctxPara.setLineDash([]);

            ctxPara.fillStyle = '#f43f5e';
            ctxPara.font = 'bold 9px "JetBrains Mono"';
            ctxPara.textAlign = 'center';
            ctxPara.fillText(`IMPACTO ESTIMADO (~${maxX.toFixed(1)}m)`, impactX, groundY - 34);

            // Indicador de Altura Máxima Apogeo en Y
            const apexY = groundY - (maxY * dynamicScalePixelPerMeter);
            ctxPara.strokeStyle = 'rgba(56, 189, 248, 0.4)';
            ctxPara.lineWidth = 1.5;
            ctxPara.setLineDash([3, 3]);
            ctxPara.beginPath();
            ctxPara.moveTo(rulerY_X, apexY);
            ctxPara.lineTo(width - 20, apexY);
            ctxPara.stroke();
            ctxPara.setLineDash([]);

            ctxPara.fillStyle = '#38bdf8';
            ctxPara.font = '9px "JetBrains Mono"';
            ctxPara.textAlign = 'right';
            ctxPara.fillText(`ALTURA MÁX (APOGEO ~${maxY.toFixed(1)}m)`, width - 30, apexY - 6);

            // Torre / Estructura del Cañón si h0 > 0
            if (h0 > 0) {
                ctxPara.fillStyle = '#334155';
                ctxPara.fillRect(cannonX - 20, cannonY, 40, groundY - cannonY);

                ctxPara.strokeStyle = '#475569';
                ctxPara.lineWidth = 2;
                ctxPara.strokeRect(cannonX - 20, cannonY, 40, groundY - cannonY);

                ctxPara.fillStyle = '#cbd5e1';
                ctxPara.font = '10px "JetBrains Mono"';
                ctxPara.textAlign = 'right';
                ctxPara.fillText(`h₀=${h0}m`, cannonX - 25, cannonY + 14);
            }

            // Ejes de Referencia
            ctxPara.strokeStyle = 'rgba(255, 255, 255, 0.1)';
            ctxPara.setLineDash([4, 4]);
            ctxPara.beginPath();
            ctxPara.moveTo(cannonX, 0);
            ctxPara.lineTo(cannonX, groundY);
            ctxPara.moveTo(0, cannonY);
            ctxPara.lineTo(width, cannonY);
            ctxPara.stroke();
            ctxPara.setLineDash([]);

            // Ángulo de inclinación del cañón
            const angleVal = document.getElementById('para-angle').value;
            const angleDeg = angleVal !== "" ? parseFloat(angleVal) : 45;
            const angleRad = (angleDeg * Math.PI) / 180;

            // Tubo del Cañón
            const cannonLength = 40;
            const barrelEndX = cannonX + cannonLength * Math.cos(angleRad);
            const barrelEndY = cannonY - cannonLength * Math.sin(angleRad);

            ctxPara.strokeStyle = '#f43f5e';
            ctxPara.lineWidth = 12;
            ctxPara.lineCap = 'round';
            ctxPara.beginPath();
            ctxPara.moveTo(cannonX, cannonY);
            ctxPara.lineTo(barrelEndX, barrelEndY);
            ctxPara.stroke();

            // Base Pivot
            ctxPara.fillStyle = '#cbd5e1';
            ctxPara.beginPath();
            ctxPara.arc(cannonX, cannonY, 12, 0, Math.PI * 2);
            ctxPara.fill();

            // Dibujar Parciales Capturados (Cruces sin líneas proyectadas a ejes)
            paraSplits.forEach((split, index) => {
                const sX = cannonX + (split.totalX * dynamicScalePixelPerMeter);
                const sY = cannonY - ((split.totalY - h0) * dynamicScalePixelPerMeter);

                // 1. Cruz en la intersección exacta (Split Point)
                const crossSize = 6;
                ctxPara.strokeStyle = '#f43f5e';
                ctxPara.lineWidth = 2;
                ctxPara.beginPath();
                // Línea vertical de la cruz
                ctxPara.moveTo(sX, sY - crossSize);
                ctxPara.lineTo(sX, sY + crossSize);
                // Línea horizontal de la cruz
                ctxPara.moveTo(sX - crossSize, sY);
                ctxPara.lineTo(sX + crossSize, sY);
                ctxPara.stroke();

                // 2. Etiquetas de Distancia Relativa al Cañón
                const relX_m = split.totalX; // m desde el cañón
                const relY_m = split.totalY - h0; // m respecto a la posición inicial del cañón

                // Arriba de la cruz: Distancia recorrida en Y respecto al cañón
                ctxPara.fillStyle = 'var(--accent-parabolico)';
                ctxPara.font = 'bold 9px "JetBrains Mono"';
                ctxPara.textAlign = 'center';
                ctxPara.fillText(`Y: ${relY_m >= 0 ? '+' : ''}${relY_m.toFixed(1)}m`, sX, sY - 9);

                // Lado derecho de la cruz: Distancia recorrida en X respecto al cañón
                ctxPara.textAlign = 'left';
                ctxPara.fillText(`X: ${relX_m.toFixed(1)}m`, sX + 9, sY + 3);
            });

            // Posición Actual del Proyectil
            const currentProjX = cannonX + (paraX * dynamicScalePixelPerMeter);
            const currentProjY = cannonY - (paraY * dynamicScalePixelPerMeter);

            if (paraIsRunning || paraTime > 0) {
                ctxPara.fillStyle = '#f43f5e';
                ctxPara.shadowColor = '#f43f5e';
                ctxPara.shadowBlur = 15;
                ctxPara.beginPath();
                ctxPara.arc(currentProjX, currentProjY, 8, 0, Math.PI * 2);
                ctxPara.fill();
                ctxPara.shadowBlur = 0;
            }
        }

        function updateParabolico(timestamp) {
            if (!paraIsRunning) return;

            if (!lastTimestamp) lastTimestamp = timestamp;
            const deltaTime = (timestamp - lastTimestamp) / 1000;
            lastTimestamp = timestamp;

            const h0 = parseFloat(document.getElementById('para-h0').value) || 0;
            const v0 = parseFloat(document.getElementById('para-v0').value) || 45;
            const angleVal = document.getElementById('para-angle').value;
            const angleDeg = angleVal !== "" ? parseFloat(angleVal) : 45;
            const g = parseFloat(document.getElementById('para-g').value) || 9.81;

            const angleRad = (angleDeg * Math.PI) / 180;
            const v0x = v0 * Math.cos(angleRad);
            const v0y = v0 * Math.sin(angleRad);

            paraTime += deltaTime;

            paraX = v0x * paraTime;
            paraY = (v0y * paraTime) - (0.5 * g * Math.pow(paraTime, 2));

            const autoSplitEnabled = document.getElementById('para-auto-split').checked;
            const interval = parseFloat(document.getElementById('para-split-interval').value) || 1;

            if (autoSplitEnabled && paraTime >= paraNextAutoSplitTime) {
                takeParaSplit();
                paraNextAutoSplitTime = paraTime + interval;
            }

            const groundLimitMeters = -h0;

            if (paraTime > 0.05 && paraY <= groundLimitMeters) {
                paraY = groundLimitMeters;

                const disc = Math.pow(v0y, 2) + (2 * g * h0);
                if (disc >= 0) {
                    paraTime = (v0y + Math.sqrt(disc)) / g;
                    paraX = v0x * paraTime;
                }

                paraIsRunning = false;
                cancelAnimationFrame(paraAnimationId);

                document.getElementById('btn-para-start').textContent = 'Impacto';
                document.getElementById('btn-para-start').style.background = '#ef4444';
                document.getElementById('para-status-disp').textContent = 'Impactó';
                document.getElementById('para-status-disp').style.color = '#ef4444';
            } else {
                document.getElementById('para-status-disp').textContent = 'En vuelo...';
                document.getElementById('para-status-disp').style.color = 'var(--accent-parabolico)';
            }

            const absoluteY = paraY + h0;

            document.getElementById('para-time-disp').textContent = `${paraTime.toFixed(2)} s`;
            document.getElementById('para-x-disp').textContent = `${paraX.toFixed(1)} m`;
            document.getElementById('para-y-disp').textContent = `${absoluteY.toFixed(1)} m`;

            drawParabolicoScene();

            if (paraIsRunning) {
                paraAnimationId = requestAnimationFrame(updateParabolico);
            }
        }

        function toggleParabolico() {
            const btn = document.getElementById('btn-para-start');
            const h0 = parseFloat(document.getElementById('para-h0').value) || 0;

            // Si el proyectil ya impactó, reiniciar primero antes de un nuevo disparo
            if (paraY <= -h0 && paraTime > 0) {
                resetParabolico();
            }

            if (paraIsRunning) {
                paraIsRunning = false;
                cancelAnimationFrame(paraAnimationId);
                btn.textContent = 'Reanudar';
                btn.style.background = 'var(--accent-parabolico)';
            } else {
                startFlightAnimation();
            }
        }

        function startCountdown(callback) {
            isCountingDown = true;
            const overlay = document.getElementById('countdown-overlay');
            const numDisp = document.getElementById('countdown-number');
            let count = 3;

            overlay.classList.add('active');
            numDisp.textContent = count;

            const interval = setInterval(() => {
                count--;
                if (count > 0) {
                    numDisp.style.animation = 'none';
                    void numDisp.offsetWidth;
                    numDisp.style.animation = 'popIn 0.5s ease-out';
                    numDisp.textContent = count;
                } else if (count === 0) {
                    numDisp.style.animation = 'none';
                    void numDisp.offsetWidth;
                    numDisp.style.animation = 'popIn 0.5s ease-out';
                    numDisp.textContent = 'Go!';
                } else {
                    clearInterval(interval);
                    overlay.classList.remove('active');
                    isCountingDown = false;
                    callback();
                }
            }, 800);
        }

        function startFlightAnimation() {
            const btn = document.getElementById('btn-para-start');
            paraIsRunning = true;
            lastTimestamp = 0;

            const interval = parseFloat(document.getElementById('para-split-interval').value) || 1;
            if (paraTime === 0) {
                paraNextAutoSplitTime = interval;
            }

            paraAnimationId = requestAnimationFrame(updateParabolico);
            btn.textContent = 'Pausar';
            btn.style.background = '#f59e0b';
        }

        function takeParaSplit() {
            if (paraTime === 0) return;

            const h0 = parseFloat(document.getElementById('para-h0').value) || 0;
            const absoluteY = paraY + h0;

            const relTime = paraTime - paraLastSplitTime;
            const relX = paraX - paraLastSplitX;
            const relY = paraY - paraLastSplitY;

            const splitData = {
                id: paraSplits.length + 1,
                totalTime: paraTime,
                totalX: paraX,
                totalY: absoluteY,
                relTime: relTime,
                relX: relX,
                relY: relY
            };

            paraSplits.push(splitData);

            paraLastSplitTime = paraTime;
            paraLastSplitX = paraX;
            paraLastSplitY = paraY;

            renderParaSplitsTable();
            drawParabolicoScene();
        }

        function renderParaSplitsTable() {
            const tbody = document.getElementById('para-splits-body');
            if (paraSplits.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" style="color: var(--text-muted); text-align: center; padding: 10px 0;">Sin parciales</td></tr>`;
                return;
            }

            tbody.innerHTML = paraSplits.map(s => `
                <tr>
                    <td style="color: var(--accent-parabolico); font-weight: bold;">#${s.id}</td>
                    <td>${s.totalTime.toFixed(2)}s / ${s.totalX.toFixed(1)}m / ${s.totalY.toFixed(1)}m</td>
                    <td style="color: #fda4af;">+${s.relTime.toFixed(2)}s / Δx ${s.relX.toFixed(1)}m / Δy ${s.relY.toFixed(1)}m</td>
                </tr>
            `).join('');
        }

        function resetParabolico() {
            paraIsRunning = false;
            cancelAnimationFrame(paraAnimationId);

            paraTime = 0;
            paraX = 0;
            paraY = 0;
            lastTimestamp = 0;

            paraSplits = [];
            paraLastSplitTime = 0;
            paraLastSplitX = 0;
            paraLastSplitY = 0;

            const interval = parseFloat(document.getElementById('para-split-interval').value) || 1;
            paraNextAutoSplitTime = interval;

            const h0 = parseFloat(document.getElementById('para-h0').value) || 0;

            document.getElementById('para-time-disp').textContent = '0.00 s';
            document.getElementById('para-x-disp').textContent = '0.0 m';
            document.getElementById('para-y-disp').textContent = `${h0.toFixed(1)} m`;
            document.getElementById('para-status-disp').textContent = 'Listo';
            document.getElementById('para-status-disp').style.color = 'var(--accent-parabolico)';

            const btn = document.getElementById('btn-para-start');
            btn.textContent = 'Disparar';
            btn.style.background = 'var(--accent-parabolico)';

            renderParaSplitsTable();
            drawParabolicoScene();
        }

        window.addEventListener('resize', initParabolico);
        window.addEventListener('DOMContentLoaded', initParabolico);
    </script>
</body>
</html>
