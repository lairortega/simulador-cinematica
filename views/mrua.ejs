<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Simulador Física</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .mrua-layout {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 24px;
            height: calc(100vh - 140px);
        }

        .mrua-card {
            display: flex;
            flex-direction: column;
            gap: 16px;
            overflow-y: auto;
        }

        .mrua-simulation-view {
            position: relative;
            background: #020617;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            height: 100%;
            width: 100%;
            display: flex;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .btn-split-mrua {
            background: rgba(168, 85, 247, 0.15);
            border: 1px solid var(--accent-mrua);
            color: var(--accent-mrua);
        }

        .btn-split-mrua:hover {
            background: rgba(168, 85, 247, 0.25);
        }

        .auto-split-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(0, 0, 0, 0.2);
            padding: 8px 12px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 0.82rem;
            color: var(--text-muted);
            user-select: none;
        }

        .checkbox-container input[type="checkbox"] {
            accent-color: var(--accent-mrua);
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

        .interval-wrapper {
            display: none;
            align-items: center;
            gap: 6px;
        }

        .interval-wrapper.active {
            display: flex;
        }

        /* Estilo del Selector / Presets de Gravedad */
        .select-preset {
            font-family: var(--font-main);
            font-size: 0.85rem;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 12px;
            border-radius: var(--radius-md);
            width: 100%;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
        }

        .select-preset:focus {
            border-color: var(--accent-mrua);
        }

        .select-preset option {
            background-color: var(--bg-card);
            color: var(--text-main);
        }
    </style>
</head>
<body>

    <!-- Menú Lateral Reutilizable -->
    <%- include('partials/sidebar') %>

    <!-- Área de Contenido Principal -->
    <main style="height: 100vh; overflow: hidden; display: flex; flex-direction: column;">
        <div class="section-header" style="margin-bottom: 16px;">
            <div>
                <h1 class="section-title">MRUA / Caída Libre</h1>
                <p class="section-subtitle">Movimiento vertical bajo la aceleración constante de la gravedad.</p>
            </div>
            <span class="section-badge" id="g-badge" style="color: var(--accent-mrua); border-color: var(--accent-mrua);">g = 9.81 m/s²</span>
        </div>

        <div class="mrua-layout">
            <div class="card mrua-card">
                <h2 class="card-title">Parámetros de Caída</h2>

                <div class="input-group">
                    <label for="mrua-h">Altura Inicial (h₀)</label>
                    <div class="input-control">
                        <input type="range" id="mrua-h" min="10" max="500" step="5" value="100">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="mrua-h-num" min="10" max="500" value="100">
                            <span class="unit-label">m</span>
                        </div>
                    </div>
                </div>

                <div class="input-group">
                    <label for="mrua-v0">Velocidad Inicial Vertical (v₀)</label>
                    <div class="input-control">
                        <input type="range" id="mrua-v0" min="-50" max="50" step="1" value="0">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="mrua-v0-num" min="-50" max="50" value="0">
                            <span class="unit-label">m/s</span>
                        </div>
                    </div>
                </div>

                <div class="input-group">
                    <label for="mrua-g">Gravedad (g)</label>
                    <div class="input-control">
                        <input type="range" id="mrua-g" min="0.5" max="300" step="0.1" value="9.8">
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="mrua-g-num" min="0.5" max="300" step="0.1" value="9.8">
                            <span class="unit-label">m/s²</span>
                        </div>
                    </div>
                </div>

                <!-- Selector de Presets Planetarios -->
                <div class="input-group">
                    <label for="mrua-gravity-preset">Preset de Gravedad Planetaria / Estelar</label>
                    <select id="mrua-gravity-preset" class="select-preset" onchange="applyGravityPreset()">
                        <option value="" disabled selected>-- Seleccionar cuerpo celeste --</option>
                        <optgroup label="Estrellas y Planetas">
                            <option value="274">Sol (274 m/s²)</option>
                            <option value="3.7">Mercurio (3.7 m/s²)</option>
                            <option value="8.87">Venus (8.87 m/s²)</option>
                            <option value="9.81">Tierra (9.81 m/s²)</option>
                            <option value="3.71">Marte (3.71 m/s²)</option>
                            <option value="24.79">Júpiter (24.79 m/s²)</option>
                            <option value="10.44">Saturno (10.44 m/s²)</option>
                            <option value="8.69">Urano (8.69 m/s²)</option>
                            <option value="11.15">Neptuno (11.15 m/s²)</option>
                            <option value="0.62">Plutón (0.62 m/s²)</option>
                        </optgroup>
                        <optgroup label="Satelites Naturales">
                            <option value="1.62">Luna (Tierra) (1.62 m/s²)</option>
                            <option value="1.796">Ío (Júpiter) (1.80 m/s²)</option>
                            <option value="1.315">Europa (Júpiter) (1.32 m/s²)</option>
                            <option value="1.428">Ganímedes (Júpiter) (1.43 m/s²)</option>
                            <option value="1.235">Calisto (Júpiter) (1.24 m/s²)</option>
                        </optgroup>
                    </select>
                </div>

                <!-- Opción Parciales Automáticos -->
                <div class="auto-split-box">
                    <label class="checkbox-container">
                        <input type="checkbox" id="mrua-auto-split" onchange="toggleMRUAAutoSplitUI()">
                        <span>Parciales Automáticos</span>
                    </label>

                    <div class="interval-wrapper" id="mrua-interval-wrapper">
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Cada:</span>
                        <div class="number-input-wrapper">
                            <input type="number" class="value-input" id="mrua-split-interval" min="0.1" max="60" step="0.5" value="1" style="width: 65px;">
                            <span class="unit-label">s</span>
                        </div>
                    </div>
                </div>

                <div class="metrics-panel">
                    <div>
                        <div class="metric-title">Tiempo (t)</div>
                        <div class="metric-value" id="mrua-time-disp">0.00 s</div>
                    </div>
                    <div>
                        <div class="metric-title">Altura (y)</div>
                        <div class="metric-value" id="mrua-pos-disp">100.0 m</div>
                    </div>
                    <div>
                        <div class="metric-title">Velocidad (v)</div>
                        <div class="metric-value" id="mrua-vel-disp">0.00 m/s</div>
                    </div>
                    <div>
                        <div class="metric-title">Estado</div>
                        <div class="metric-value" id="mrua-status-disp" style="font-size: 0.85rem; color: var(--accent-mrua);">Listo</div>
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn-action" id="btn-mrua-start" style="background: var(--accent-mrua); color: #fff;" onclick="toggleMRUA()">Soltar / Iniciar</button>
                    <button class="btn-action btn-split-mrua" onclick="takeMRUASplit()">Parcial</button>
                    <button class="btn-action btn-secondary" onclick="resetMRUA()">Reiniciar</button>
                </div>

                <!-- Tabla de Registro de Parciales -->
                <div class="splits-card">
                    <div class="splits-title">Tiempos Parciales</div>
                    <table class="splits-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Total (t / y)</th>
                                <th>Relativo (Δt / Δy)</th>
                            </tr>
                        </thead>
                        <tbody id="mrua-splits-body">
                            <tr>
                                <td colspan="3" style="color: var(--text-muted); text-align: center; padding: 10px 0;">Sin parciales</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mrua-simulation-view" id="mrua-container">
                <canvas id="canvas-mrua"></canvas>
            </div>
        </div>
    </main>

    <script>
        function applyGravityPreset() {
            const select = document.getElementById('mrua-gravity-preset');
            const gVal = parseFloat(select.value);

            if (!isNaN(gVal)) {
                const slider = document.getElementById('mrua-g');
                const numInput = document.getElementById('mrua-g-num');

                slider.value = gVal;
                numInput.value = gVal;

                document.getElementById('g-badge').textContent = `g = ${gVal} m/s²`;

                if (!mruaIsRunning && typeof drawMRUAScene === 'function') {
                    drawMRUAScene();
                }
            }
        }

        function toggleMRUAAutoSplitUI() {
            const isChecked = document.getElementById('mrua-auto-split').checked;
            const wrapper = document.getElementById('mrua-interval-wrapper');
            if (isChecked) {
                wrapper.classList.add('active');
            } else {
                wrapper.classList.remove('active');
            }
        }

        // Sincronización bidireccional entre Sliders e Inputs Numéricos
        document.querySelectorAll('input[type="range"]').forEach(slider => {
            const numInput = document.getElementById(`${slider.id}-num`);
            
            if (numInput) {
                slider.addEventListener('input', (e) => {
                    numInput.value = e.target.value;
                    triggerMRUAInputEvent(slider.id);
                });

                numInput.addEventListener('input', (e) => {
                    let val = parseFloat(e.target.value);
                    const min = parseFloat(slider.min);
                    const max = parseFloat(slider.max);

                    if (isNaN(val)) return;

                    if (val < min) val = min;
                    if (val > max) val = max;

                    slider.value = val;
                    triggerMRUAInputEvent(slider.id);
                });
            }
        });

        function triggerMRUAInputEvent(id) {
            if (id === 'mrua-g' || id === 'mrua-g-num') {
                const gVal = document.getElementById('mrua-g').value;
                document.getElementById('g-badge').textContent = `g = ${gVal} m/s²`;
            }

            if (!mruaIsRunning && typeof drawMRUAScene === 'function') {
                mruaInitialHeight = parseFloat(document.getElementById('mrua-h').value) || 100;
                mruaHeight = mruaInitialHeight;
                document.getElementById('mrua-pos-disp').textContent = `${mruaHeight.toFixed(1)} m`;
                drawMRUAScene();
            }
        }

        // -------------------------------------------------------------
        // SIMULADOR CAÍDA LIBRE / MRUA VERTICAL
        // -------------------------------------------------------------
        let canvasMRUA, ctxMRUA;
        let mruaAnimationId = null;
        let mruaIsRunning = false;
        let mruaTime = 0;
        let mruaInitialHeight = 100;
        let mruaHeight = 100;
        let mruaVelocity = 0;
        let lastTimestamp = 0;

        let mruaSplits = [];
        let mruaLastSplitTime = 0;
        let mruaLastSplitHeight = 100;
        let mruaNextAutoSplitTime = 0;

        function initMRUA() {
            canvasMRUA = document.getElementById('canvas-mrua');
            const container = document.getElementById('mrua-container');
            
            if (!canvasMRUA || !container) return;

            canvasMRUA.width = container.clientWidth;
            canvasMRUA.height = container.clientHeight;

            ctxMRUA = canvasMRUA.getContext('2d');
            mruaInitialHeight = parseFloat(document.getElementById('mrua-h').value) || 100;
            mruaHeight = mruaInitialHeight;
            mruaLastSplitHeight = mruaInitialHeight;
            drawMRUAScene();
        }

        function drawMRUAScene() {
            const width = canvasMRUA.width;
            const height = canvasMRUA.height;
            const maxHeight = parseFloat(document.getElementById('mrua-h').value) || 100;

            ctxMRUA.clearRect(0, 0, width, height);

            const groundY = height - 50;
            const topY = 60;
            const availableHeight = groundY - topY;
            const pixelPerMeter = availableHeight / maxHeight;

            ctxMRUA.fillStyle = '#1e293b';
            ctxMRUA.fillRect(0, groundY, width, height - groundY);

            ctxMRUA.strokeStyle = '#a855f7';
            ctxMRUA.lineWidth = 3;
            ctxMRUA.beginPath();
            ctxMRUA.moveTo(0, groundY);
            ctxMRUA.lineTo(width, groundY);
            ctxMRUA.stroke();

            ctxMRUA.fillStyle = '#94a3b8';
            ctxMRUA.font = 'bold 12px "JetBrains Mono"';
            ctxMRUA.textAlign = 'left';
            ctxMRUA.fillText("SUELO (y = 0m)", 20, groundY + 24);

            const rulerX = 70;
            ctxMRUA.strokeStyle = '#334155';
            ctxMRUA.lineWidth = 2;
            ctxMRUA.beginPath();
            ctxMRUA.moveTo(rulerX, topY);
            ctxMRUA.lineTo(rulerX, groundY);
            ctxMRUA.stroke();

            ctxMRUA.fillStyle = '#64748b';
            ctxMRUA.font = '11px "JetBrains Mono"';
            ctxMRUA.textAlign = 'right';

            let step = 10;
            if (maxHeight > 100) step = 20;
            if (maxHeight > 250) step = 50;

            for (let m = 0; m <= maxHeight; m += step) {
                const tickY = groundY - (m * pixelPerMeter);
                ctxMRUA.beginPath();
                ctxMRUA.moveTo(rulerX - 8, tickY);
                ctxMRUA.lineTo(rulerX, tickY);
                ctxMRUA.strokeStyle = '#64748b';
                ctxMRUA.lineWidth = 1;
                ctxMRUA.stroke();
                ctxMRUA.fillText(`${m}m`, rulerX - 12, tickY + 4);
            }

            const objectX = width * 0.5;

            mruaSplits.forEach((split, index) => {
                const splitY = groundY - (split.totalHeight * pixelPerMeter);
                ctxMRUA.strokeStyle = 'rgba(168, 85, 247, 0.6)';
                ctxMRUA.lineWidth = 1.5;
                ctxMRUA.setLineDash([4, 4]);
                ctxMRUA.beginPath();
                ctxMRUA.moveTo(objectX - 60, splitY);
                ctxMRUA.lineTo(objectX + 60, splitY);
                ctxMRUA.stroke();
                ctxMRUA.setLineDash([]);

                ctxMRUA.fillStyle = 'var(--accent-mrua)';
                ctxMRUA.font = 'bold 10px "JetBrains Mono"';
                ctxMRUA.textAlign = 'right';
                ctxMRUA.fillText(`#${index + 1} (${split.totalHeight.toFixed(1)}m)`, objectX - 70, splitY + 3);
            });

            const currentY = groundY - (mruaHeight * pixelPerMeter);
            const radius = 18;

            ctxMRUA.strokeStyle = 'rgba(168, 85, 247, 0.25)';
            ctxMRUA.lineWidth = 4;
            ctxMRUA.beginPath();
            ctxMRUA.moveTo(objectX, groundY - (mruaInitialHeight * pixelPerMeter));
            ctxMRUA.lineTo(objectX, currentY);
            ctxMRUA.stroke();

            ctxMRUA.fillStyle = '#a855f7';
            ctxMRUA.shadowColor = '#a855f7';
            ctxMRUA.shadowBlur = 18;
            ctxMRUA.beginPath();
            ctxMRUA.arc(objectX, currentY, radius, 0, Math.PI * 2);
            ctxMRUA.fill();
            ctxMRUA.shadowBlur = 0;

            ctxMRUA.fillStyle = '#ffffff';
            ctxMRUA.beginPath();
            ctxMRUA.arc(objectX - 5, currentY - 5, 5, 0, Math.PI * 2);
            ctxMRUA.fill();

            ctxMRUA.fillStyle = '#a855f7';
            ctxMRUA.font = 'bold 13px "JetBrains Mono"';
            ctxMRUA.textAlign = 'left';
            ctxMRUA.fillText(`${mruaHeight.toFixed(1)} m`, objectX + radius + 15, currentY + 4);
        }

        function updateMRUA(timestamp) {
            if (!mruaIsRunning) return;

            if (!lastTimestamp) lastTimestamp = timestamp;
            const deltaTime = (timestamp - lastTimestamp) / 1000;
            lastTimestamp = timestamp;

            const h0 = parseFloat(document.getElementById('mrua-h').value) || 100;
            const v0 = parseFloat(document.getElementById('mrua-v0').value) || 0;
            const g = parseFloat(document.getElementById('mrua-g').value) || 9.81;

            mruaTime += deltaTime;

            mruaHeight = h0 + (v0 * mruaTime) - (0.5 * g * Math.pow(mruaTime, 2));
            mruaVelocity = v0 - (g * mruaTime);

            const autoSplitEnabled = document.getElementById('mrua-auto-split').checked;
            const interval = parseFloat(document.getElementById('mrua-split-interval').value) || 1;

            if (autoSplitEnabled && mruaTime >= mruaNextAutoSplitTime && mruaHeight > 0) {
                takeMRUASplit();
                mruaNextAutoSplitTime = mruaTime + interval;
            }

            if (mruaHeight <= 0) {
                mruaHeight = 0;
                mruaIsRunning = false;
                cancelAnimationFrame(mruaAnimationId);

                document.getElementById('btn-mrua-start').textContent = 'Impacto';
                document.getElementById('btn-mrua-start').style.background = '#ef4444';
                document.getElementById('mrua-status-disp').textContent = 'Impactó el suelo';
                document.getElementById('mrua-status-disp').style.color = '#ef4444';
            } else {
                document.getElementById('mrua-status-disp').textContent = 'En caída...';
                document.getElementById('mrua-status-disp').style.color = 'var(--accent-mrua)';
            }

            document.getElementById('mrua-time-disp').textContent = `${mruaTime.toFixed(2)} s`;
            document.getElementById('mrua-pos-disp').textContent = `${mruaHeight.toFixed(1)} m`;
            document.getElementById('mrua-vel-disp').textContent = `${mruaVelocity.toFixed(1)} m/s`;

            drawMRUAScene();

            if (mruaIsRunning) {
                mruaAnimationId = requestAnimationFrame(updateMRUA);
            }
        }

        function toggleMRUA() {
            const btn = document.getElementById('btn-mrua-start');

            if (mruaHeight <= 0) {
                resetMRUA();
            }

            if (mruaIsRunning) {
                mruaIsRunning = false;
                cancelAnimationFrame(mruaAnimationId);
                btn.textContent = 'Reanudar';
                btn.style.background = 'var(--accent-mrua)';
            } else {
                mruaIsRunning = true;
                lastTimestamp = 0;

                const interval = parseFloat(document.getElementById('mrua-split-interval').value) || 1;
                if (mruaTime === 0) {
                    mruaNextAutoSplitTime = interval;
                }

                mruaAnimationId = requestAnimationFrame(updateMRUA);
                btn.textContent = 'Pausar';
                btn.style.background = '#f59e0b';
            }
        }

        function takeMRUASplit() {
            if (mruaTime === 0) return;

            const relTime = mruaTime - mruaLastSplitTime;
            const relHeight = Math.abs(mruaHeight - mruaLastSplitHeight);

            const splitData = {
                id: mruaSplits.length + 1,
                totalTime: mruaTime,
                totalHeight: mruaHeight,
                relTime: relTime,
                relHeight: relHeight
            };

            mruaSplits.push(splitData);

            mruaLastSplitTime = mruaTime;
            mruaLastSplitHeight = mruaHeight;

            renderMRUASplitsTable();
            drawMRUAScene();
        }

        function renderMRUASplitsTable() {
            const tbody = document.getElementById('mrua-splits-body');
            if (mruaSplits.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" style="color: var(--text-muted); text-align: center; padding: 10px 0;">Sin parciales</td></tr>`;
                return;
            }

            tbody.innerHTML = mruaSplits.map(s => `
                <tr>
                    <td style="color: var(--accent-mrua); font-weight: bold;">#${s.id}</td>
                    <td>${s.totalTime.toFixed(2)}s / ${s.totalHeight.toFixed(1)}m</td>
                    <td style="color: #c084fc;">+${s.relTime.toFixed(2)}s / Δ${s.relHeight.toFixed(1)}m</td>
                </tr>
            `).join('');
        }

        function resetMRUA() {
            mruaIsRunning = false;
            cancelAnimationFrame(mruaAnimationId);
            mruaTime = 0;
            mruaInitialHeight = parseFloat(document.getElementById('mrua-h').value) || 100;
            mruaHeight = mruaInitialHeight;
            mruaVelocity = parseFloat(document.getElementById('mrua-v0').value) || 0;
            lastTimestamp = 0;

            mruaSplits = [];
            mruaLastSplitTime = 0;
            mruaLastSplitHeight = mruaInitialHeight;

            const interval = parseFloat(document.getElementById('mrua-split-interval').value) || 1;
            mruaNextAutoSplitTime = interval;

            document.getElementById('mrua-time-disp').textContent = '0.00 s';
            document.getElementById('mrua-pos-disp').textContent = `${mruaHeight.toFixed(1)} m`;
            document.getElementById('mrua-vel-disp').textContent = `${mruaVelocity.toFixed(1)} m/s`;
            document.getElementById('mrua-status-disp').textContent = 'Listo';
            document.getElementById('mrua-status-disp').style.color = 'var(--accent-mrua)';

            const btn = document.getElementById('btn-mrua-start');
            btn.textContent = 'Soltar / Iniciar';
            btn.style.background = 'var(--accent-mrua)';

            renderMRUASplitsTable();
            drawMRUAScene();
        }

        window.addEventListener('resize', initMRUA);
        window.addEventListener('DOMContentLoaded', initMRUA);
    </script>
</body>
</html>
